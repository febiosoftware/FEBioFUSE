<?xml version="1.0" encoding="ISO-8859-1"?>
<febio_study type="fuse">
    <models>
        <primary_model name="chem"/>
        <model name="mech" file="mech.feb">
            <log_output>1</log_output>
        </model>
    </models>
    <exchanges>
        <exchange src="mech.elem_data('effective stress')" dst="chem.mesh_data('k_map')">
            <filter type="scale">
                <scale>0.1</scale>
            </filter>
        </exchange>
        <exchange src="chem.elem_data('c2')" dst="mech.mesh_data('E_map')">
            <filter type="scale">
                <scale>1e4</scale>
            </filter>
        </exchange>
        <exchange type="param-to-param" src="chem.time" dst="mech.load[0].pressure">
            <filter type="scale">
                <scale>1.0</scale>
            </filter>
        </exchange>
    </exchanges>
</febio_study>
